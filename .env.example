# Google Sheets — Product Database
# Leave these empty to use built-in seed/placeholder data instead.

# The ID from your Google Spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service Account credentials (from Google Cloud Console → IAM → Service Accounts)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
